# Android 11 TWRP fstab for RK3566 Dangbei DBBOX5C

# [更改] 统一使用 /dev/block/by-name/ 路径
# [更改] 删除不必要分区，修正 userdata 路径
# [更改] 外部 SD 卡路径由 mmcblk0p1 改为 mmcblk1p1（通常 TF 卡为 mmcblk1）

/system          ext4    /dev/block/by-name/system        flags=display=system
/vendor          ext4    /dev/block/by-name/vendor        flags=display=vendor
/odm             ext4    /dev/block/by-name/odm           flags=display=odm
/product         ext4    /dev/block/by-name/product       flags=display=product
/system_ext      ext4    /dev/block/by-name/system_ext    flags=display=system_ext
/cache           ext4    /dev/block/by-name/cache         flags=display=cache
/metadata        ext4    /dev/block/by-name/metadata      flags=display=metadata
/data            ext4    /dev/block/by-name/userdata      flags=display=data;settingsstorage;wipeingui;backup=1
/boot            emmc    /dev/block/by-name/boot          flags=display=boot;backup=1;flashimg=1
/recovery        emmc    /dev/block/by-name/recovery      flags=display=recovery;backup=1;flashimg=1
/misc            emmc    /dev/block/by-name/misc          flags=display=misc
/vbmeta          emmc    /dev/block/by-name/vbmeta        flags=display=vbmeta;backup=1;flashimg=1
/dtbo            emmc    /dev/block/by-name/dtbo          flags=display=dtbo;backup=1;flashimg=1
/vendor_boot     emmc    /dev/block/by-name/vendor_boot   flags=display=vendor_boot;backup=1;flashimg=1
/external_sd     vfat    /dev/block/mmcblk1p1             flags=display=external_sd;storage;removable